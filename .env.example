# Prospecto — variables d'environnement (EXEMPLE UNIQUEMENT)
# Copier vers .env et renseigner en local. Ne JAMAIS committer .env.
# Le cœur du moteur (qualification, génération, file de validation) fonctionne
# sans aucune clé : l'accès Gmail se fait via le connecteur sécurisé de l'agent.

# Identité expéditeur (déjà publique, signature des emails)
PROSPECTO_SENDER_NAME=Martin BOURASSEAU
PROSPECTO_SENDER_EMAIL=martin.bourasseau4@gmail.com
PROSPECTO_PORTFOLIO_URL=https://prospecto.website

# Optionnel : intégrations futures (laisser vide si inutilisé)
# GMAIL_API_TOKEN=
# SEARCH_API_KEY=
